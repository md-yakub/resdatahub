spring.datasource.url=jdbc:postgresql://127.0.0.1:5434/db_name
spring.datasource.username=db_user
spring.datasource.password=db_pass

resdatahub.minio.endpoint=http://127.0.0.1:9000
resdatahub.minio.access-key=minio_user
resdatahub.minio.secret-key=minio_password
resdatahub.minio.bucket=resdatahub-files

resdatahub.public-base-url=http://localhost:8080
resdatahub.cors.allowed-origins=http://localhost:3000
resdatahub.catalog.title=ResDataHub Catalog
resdatahub.catalog.description=Catalog of published ResDataHub dataset versions.
resdatahub.catalog.publisher-name=ResDataHub
resdatahub.catalog.publisher-uri=
resdatahub.catalog.homepage=http://localhost:8080
resdatahub.catalog.language=en
resdatahub.catalog.issued=2026-01-01T00:00:00Z
resdatahub.catalog.contact=
